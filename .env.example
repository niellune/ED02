# Copy to .env (or set in your host's dashboard). Only SESSION_SECRET and BASE_URL are required to run.
NODE_ENV=production
PORT=3000
BASE_URL=https://keepqr.example.com
# openssl rand -base64 48
SESSION_SECRET=
DATABASE_PATH=/data/keepqr.db
# Set to 1 when running behind a single reverse proxy (Fly, Render, Railway, Nginx)
TRUST_PROXY=1

SUPPORT_EMAIL=support@keepqr.example.com
ADMIN_EMAILS=you@example.com

# Stripe (dashboard.stripe.com -> Developers). Create one Product "KeepQR Pro" with two recurring prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Transactional email via resend.com (optional: without it, emails are printed to the log)
RESEND_API_KEY=
MAIL_FROM=KeepQR <no-reply@keepqr.example.com>

# Optional privacy-friendly analytics (plausible.io)
PLAUSIBLE_DOMAIN=
# Extra comma-separated domains that codes may not point to
BLOCKED_DOMAINS=
